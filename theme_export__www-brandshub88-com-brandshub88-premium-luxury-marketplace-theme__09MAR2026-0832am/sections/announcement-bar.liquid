{% if section.settings.text != blank %}
<section class="announcement-bar">
  <div class="container announcement-bar__inner">
    <span>{{ section.settings.text }}</span>
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">Learn more</a>
    {% endif %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Authentic luxury watches & accessories • Worldwide delivery" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
