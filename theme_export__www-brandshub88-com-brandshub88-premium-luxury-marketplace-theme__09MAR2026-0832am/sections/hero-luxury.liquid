<section class="hero-luxury">
  <div class="hero-luxury__bg">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2200 }}" alt="{{ section.settings.heading | escape }}" loading="eager">
    {% else %}
      <div class="hero-luxury__fallback"></div>
    {% endif %}
  </div>
  <div class="hero-luxury__overlay"></div>
  <div class="container hero-luxury__content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="hero-luxury__text">{{ section.settings.text }}</p>
    <div class="hero-luxury__actions">
      <a class="btn btn--dark" href="{{ section.settings.primary_link | default: '/collections/all' }}">{{ section.settings.primary_label }}</a>
      <a class="btn btn--light" href="{{ section.settings.secondary_link | default: '/collections/all' }}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero luxury",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated luxury marketplace" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium Watches. Modern Luxury. Global Reach." },
    { "type": "text", "id": "text", "label": "Text", "default": "Discover luxury watches and accessories with a clean premium experience built for modern collectors." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop Collection" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Browse Brands" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero luxury" }]
}
{% endschema %}
