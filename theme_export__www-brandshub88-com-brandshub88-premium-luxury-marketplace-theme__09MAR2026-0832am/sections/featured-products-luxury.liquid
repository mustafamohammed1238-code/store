{% assign selected_collection = collections[section.settings.collection] %}
<section class="section section--soft">
  <div class="container">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Featured selection</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <a class="text-link" href="{{ selected_collection.url | default: '/collections/all' }}">View all</a>
    </div>
    <div class="product-grid">
      {% for product in selected_collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products luxury",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured products luxury" }]
}
{% endschema %}
