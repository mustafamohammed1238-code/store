<section class="bh-home section">
  <div class="container">
    <div class="bh-home__hero">
      <div class="bh-home__copy">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p class="hero-luxury__text">{{ section.settings.text }}</p>
        <div class="hero-luxury__actions">
          <a class="btn btn--dark" href="{{ section.settings.primary_link | default: '/collections/all' }}">{{ section.settings.primary_label }}</a>
          <a class="btn btn--light" href="{{ section.settings.secondary_link | default: '/collections/all' }}">{{ section.settings.secondary_label }}</a>
        </div>
        <ul class="bh-home__meta" role="list">
          <li>{{ section.settings.meta_1 }}</li>
          <li>{{ section.settings.meta_2 }}</li>
          <li>{{ section.settings.meta_3 }}</li>
        </ul>
      </div>

      <div class="bh-home__media">
        {% if section.settings.hero_image != blank %}
          <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="{{ section.settings.heading | escape }}" loading="eager">
        {% else %}
          <div class="placeholder-box placeholder-box--large"></div>
        {% endif %}
      </div>
    </div>

    <div class="bh-home__usp">
      {% for block in section.blocks %}
        {% if block.type == 'usp' %}
          <article class="bh-home__usp-item" {{ block.shopify_attributes }}>
            <p class="bh-home__usp-title">{{ block.settings.title }}</p>
            <p class="bh-home__usp-text">{{ block.settings.text }}</p>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brands Hub88 Home",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BRANDS HUB88" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium Watches. Distinct Style. Built Around Trust." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover a refined selection of automatic and quartz watches curated for collectors and first-time buyers alike." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop All Watches" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "New Arrivals" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "meta_1", "label": "Meta line 1", "default": "Secure checkout" },
    { "type": "text", "id": "meta_2", "label": "Meta line 2", "default": "Worldwide shipping" },
    { "type": "text", "id": "meta_3", "label": "Meta line 3", "default": "Dedicated support" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Authenticity Promise" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every listed product includes transparent details and clear condition information." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands Hub88 Home",
      "blocks": [
        { "type": "usp", "settings": { "title": "Authenticity Promise", "text": "Every listed product includes transparent details and clear condition information." } },
        { "type": "usp", "settings": { "title": "Fast Global Dispatch", "text": "Orders are packed with tracking and prepared for international delivery." } },
        { "type": "usp", "settings": { "title": "Easy Returns", "text": "Return-eligible items can be sent back within the policy window." } }
      ]
    }
  ]
}
{% endschema %}
