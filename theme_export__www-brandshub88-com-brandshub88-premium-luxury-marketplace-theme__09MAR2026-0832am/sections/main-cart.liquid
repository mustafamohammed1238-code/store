<section class="section">
  <div class="container" style="padding:60px 0;">
    <p class="eyebrow">Cart</p>
    <h1 style="font-family:'Playfair Display',serif;font-size:48px;margin:0 0 24px;">Your Cart</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div style="display:grid;gap:20px;">
          {% for item in cart.items %}
            <div style="display:grid;grid-template-columns:120px 1fr auto;gap:20px;align-items:center;padding:20px;border:1px solid #e8e2da;border-radius:18px;background:#fff;">
              
              <div>
                {% if item.image %}
                  {{
                    item.image
                    | image_url: width: 240
                    | image_tag:
                      alt: item.product.title,
                      loading: 'lazy',
                      widths: '120, 180, 240',
                      style: 'width:100%;height:auto;border-radius:12px;display:block;'
                  }}
                {% endif %}
              </div>

              <div>
                <h3 style="margin:0 0 8px;font-family:'Playfair Display',serif;font-size:28px;">{{ item.product.title }}</h3>
                <p style="margin:0 0 10px;color:#666;">{{ item.final_price | money }}</p>
                
                <label style="display:block;font-size:13px;color:#666;margin-bottom:8px;">Quantity</label>
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  style="width:90px;padding:12px;border:1px solid #ddd;border-radius:12px;"
                >
              </div>

              <div style="text-align:right;">
                <p style="margin:0 0 12px;font-weight:600;">{{ item.final_line_price | money }}</p>
                <a href="{{ item.url_to_remove }}" style="color:#999;text-decoration:none;">Remove</a>
              </div>
            </div>
          {% endfor %}
        </div>

        <div style="margin-top:30px;padding:24px;border:1px solid #e8e2da;border-radius:18px;background:#faf8f5;">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;">
            <div>
              <p style="margin:0;font-size:14px;color:#666;">Subtotal</p>
              <h2 style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:34px;">{{ cart.total_price | money }}</h2>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap;">
              <button
                type="submit"
                name="update"
                style="padding:14px 22px;border-radius:999px;border:1px solid #ddd;background:#fff;cursor:pointer;"
              >
                Update Cart
              </button>

              <button
                type="submit"
                name="checkout"
                style="padding:14px 22px;border-radius:999px;border:0;background:#111;color:#fff;cursor:pointer;"
              >
                Checkout
              </button>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <div style="padding:40px;border:1px solid #e8e2da;border-radius:18px;background:#fff;">
        <p style="margin:0 0 12px;color:#666;">Your cart is currently empty.</p>
        <a href="/collections/all" style="display:inline-block;padding:14px 22px;border-radius:999px;background:#111;color:#fff;text-decoration:none;">Continue Shopping</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}