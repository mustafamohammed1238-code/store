<header class="site-header">
  <div class="container site-header__row">
    <a class="logo" href="{{ routes.root_url }}">
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: 260 }}" alt="{{ shop.name }}" loading="lazy">
      {% else %}
        <span>{{ shop.name }}</span>
      {% endif %}
    </a>

    <button class="mobile-toggle" type="button" data-mobile-toggle aria-expanded="false" aria-controls="mobile-nav">
      Menu
    </button>

    <nav class="main-nav" id="mobile-nav">
      <ul>
        {% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}
          {% for link in section.settings.menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        {% else %}
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="/collections/all">Shop</a></li>
          <li><a href="/collections/all">New In</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        {% endif %}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="{{ routes.search_url }}">Search</a>
      <a href="/account">Account</a>
      <a href="{{ routes.cart_url }}">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
